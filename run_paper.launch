<launch>

    <arg name="project" default="lio_sam"/>

    <!-- 加载论文算法参数 -->
    <rosparam file="$(find lio_sam)/config/params_paper.yaml" command="load" />

    <!-- 论文算法单节点：集成了点云投影、特征提取、IEKF位姿估计、VGICP回环检测 -->
    <node pkg="lio_sam" type="lio_sam_paper" name="lio_sam_paper" output="screen" />

    <!-- 可选：rviz 可视化 -->
    <node pkg="rviz" type="rviz" name="rviz" args="-d $(find lio_sam)/launch/include/config/rviz.rviz" if="$(arg rviz_enable)" />

</launch>
